# Supabase project URL and publishable (anon) key: all data access goes through
# locked-down database functions.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-KEY

# Server-only, required. Never prefix these with NEXT_PUBLIC_ (docs/adr/0026).
# A Supabase secret key (Project Settings > API Keys > Secret keys, or the legacy
# service_role key). The server uses it only to start sessions.
SUPABASE_SECRET_KEY=YOUR-SECRET-KEY
# At least 32 random characters; it signs the guest cookie and hashes networks. Make one with
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it gives every browser a new guest id.
SESSION_SECRET=

# Optional, server-only: a YouTube Data API v3 key. When set, search falls back to the
# official API if keyless search fails (docs/adr/0013). Never prefix it with NEXT_PUBLIC_.
# YOUTUBE_API_KEY=
